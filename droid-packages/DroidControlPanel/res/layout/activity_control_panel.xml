<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Title Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="droidOS // RMX1805"
                style="@style/Typography.Header" />

            <TextView
                android:id="@+id/tv_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                style="@style/Typography.Value" />
        </LinearLayout>

        <!-- Section 1: Desktop Status Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_desktop"
            style="@style/Typography.Section"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_monochrome"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_usb_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                style="@style/Typography.Value"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_usb_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect USB cable to host (macOS / PC) to stream"
                style="@style/Typography.Section"
                android:textSize="10sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_toggle_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_start_desktop"
                style="@style/MonochromeButton" />
        </LinearLayout>

        <!-- Section 2: System Telemetry Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_system"
            style="@style/Typography.Section"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_monochrome"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- CPU Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU LOAD"
                        style="@style/Typography.Section" />
                    <TextView
                        android:id="@+id/tv_cpu_load"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        style="@style/Typography.Value" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREQ CLUSTER"
                        style="@style/Typography.Section" />
                    <TextView
                        android:id="@+id/tv_cpu_freq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.8 GHz"
                        style="@style/Typography.Value" />
                </LinearLayout>
            </LinearLayout>

            <!-- Memory & Thermal Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEMORY"
                        style="@style/Typography.Section" />
                    <TextView
                        android:id="@+id/tv_ram_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- / -- MB"
                        style="@style/Typography.Value" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATTERY / TEMP"
                        style="@style/Typography.Section" />
                    <TextView
                        android:id="@+id/tv_battery_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--% ( --°C )"
                        style="@style/Typography.Value" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section 3: Companion Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_companion"
            style="@style/Typography.Section"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_open_trackpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_trackpad"
            style="@style/MonochromeOutlinedButton"
            android:layout_marginBottom="20dp" />

        <!-- Section 4: Quick Controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_quick_settings"
            style="@style/Typography.Section"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_toggle_torch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TORCH: OFF"
                style="@style/MonochromeButton"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_toggle_wifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WI-FI"
                style="@style/MonochromeButton"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Section 5: Hardware & Power Control -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_power"
            style="@style/Typography.Section"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_lockdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_lockdown"
                style="@style/MonochromeButton"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_reboot_menu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_reboot_menu"
                style="@style/MonochromeOutlinedButton"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
